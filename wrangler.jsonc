{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "digital-home-frontend",
  "compatibility_date": "2026-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": ".open-next/worker.js",
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  // Set service to the actual backend Worker in this account. The CRM capture
  // path uses this binding on workers.dev and custom domains alike.
  "services": [{ "binding": "BACKEND_WORKER", "service": "digital-home-backend" }],
  "observability": {
    "enabled": true
  },
  // Runtime duplicates of NEXT_PUBLIC_ vars — Workers can't read NEXT_PUBLIC_ at runtime
  // Replace these with your own Supabase credentials
  "vars": {
    "SUPABASE_URL": "https://your-project.supabase.co",
    "SUPABASE_ANON_KEY": "your-anon-key",
    "BACKEND_URL": "https://your-backend-worker.example.workers.dev"
  }
  // CRM_CAPTURE_KEY is a secret. Its value must equal backend_settings.crm_capture_key.
}
