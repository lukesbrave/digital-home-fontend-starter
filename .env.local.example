# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Site identity
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Your Brand Name
NEXT_PUBLIC_BLOG_LABEL=Writing
NEXT_PUBLIC_BLOG_TITLE=Writing from Your Brand Name
NEXT_PUBLIC_BLOG_DESCRIPTION=Essays, guides, and practical notes from Your Brand Name.

# API authentication (shared secret between Frontend and Backend — must match both)
API_SECRET_KEY=your-api-secret-key

# CRM lead capture (CRM_CAPTURE_KEY must equal backend_settings.crm_capture_key)
BACKEND_URL=http://localhost:3001
CRM_CAPTURE_KEY=your-crm-capture-key

# Email (Resend)
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_ADDRESS=Your Name <hello@yourdomain.com>
RESEND_REPLY_TO=hello@yourdomain.com
RESEND_WEBHOOK_SECRET=whsec_your-resend-webhook-secret
